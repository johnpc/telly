<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / device-transfer rules for API 31+ (see backup_rules.xml
     for the rationale; the same set applies to both transports). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="telly-settings.xml" />
        <include domain="sharedpref" path="telly.xml" />
        <include domain="database" path="telly.db" />
        <include domain="database" path="telly.db-wal" />
        <include domain="database" path="telly.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="telly-settings.xml" />
        <include domain="sharedpref" path="telly.xml" />
        <include domain="database" path="telly.db" />
        <include domain="database" path="telly.db-wal" />
        <include domain="database" path="telly.db-shm" />
    </device-transfer>
</data-extraction-rules>
