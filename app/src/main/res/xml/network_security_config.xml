<?xml version="1.0" encoding="utf-8"?><!--
    IPTV playlists and streams are overwhelmingly served over plain http://
    (TiviMate allows them too), so cleartext is permitted for all domains.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
