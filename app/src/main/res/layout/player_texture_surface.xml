<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView-backed PlayerView for multiview panes. A SurfaceView (the
  PlayerView default) punches a hardware video-overlay hole; real TV hardware
  (e.g. Shield) has only a few overlay planes and undefined z-order among them,
  so 2-4 panes composite to black. A TextureView is drawn in the normal view
  hierarchy — unlimited, correctly clipped, and screencap-able.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:keep_content_on_player_reset="true"
    app:surface_type="texture_view"
    app:use_controller="false" />
